# Salin jadi .env.local:  cp .env.local.example .env.local
# Nilai URL tidak disimpan di repo. Minta ke grup tim Webdev IBL atau king Evan.

# URL Web App Google Apps Script (form registrasi).
NEXT_PUBLIC_BACKEND_URL=

# URL API backend IBL 2K26, diakhiri /api. Kosong = backend lokal (http://localhost:4000/api).
# Simpan baris staging & produksi di .env.local-mu sendiri; aktifkan satu, comment yang lain,
# lalu restart `npm run dev`. Produksi = data asli turnamen.
# Buka frontend lewat http://localhost:3000, bukan 127.0.0.1 atau IP jaringan, supaya CORS cocok.
NEXT_PUBLIC_API_URL=
