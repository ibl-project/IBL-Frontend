# Salin jadi .env.local:  cp .env.local.example .env.local
# Nilai URL tidak disimpan di repo. Minta ke grup tim Webdev IBL atau king Evan.

# URL Web App Google Apps Script (form registrasi). Sudah tidak dipakai: form ditutup sejak
# 10 Jul 2026 dan Web App-nya expired. Isi lagi hanya kalau form registrasi dibuka kembali.
# NEXT_PUBLIC_BACKEND_URL=

# URL API backend IBL 2K26, diakhiri /api. Wajib diisi: staging untuk uji, produksi = data asli turnamen.
# Tulis baris staging & produksi di .env.local-mu; aktifkan satu, comment yang lain, lalu restart
# `npm run dev`. Frontend tidak memakai backend lokal, jadi repo IBL-Backend tidak perlu di-clone.
# Buka frontend lewat http://localhost:3000, bukan 127.0.0.1 atau IP jaringan, supaya CORS cocok.
NEXT_PUBLIC_API_URL=
