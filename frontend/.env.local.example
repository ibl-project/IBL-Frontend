# URL Web App hasil deployment Google Apps Script
# Salin URL Web App dari langkah deployment (Langkah 5 di panduan setup) dan tempel di bawah ini:
NEXT_PUBLIC_BACKEND_URL=https://script.google.com/macros/s/AKfycbxxxxxxxxxXYZ/exec

# URL API backend IBL 2K26 (repo IBL-Backend), diakhiri /api.
# Biasanya tidak perlu: frontend/.env sudah mengarah ke staging. Isi di .env.local
# hanya kalau ingin beda sendiri (nilai .env.local mengalahkan .env).
# Staging  : https://api-staging.ibl-its.id/api
# Produksi : https://api.ibl-its.id/api   (data asli turnamen)
# Lokal    : http://localhost:4000/api
# Buka frontend lewat http://localhost:3000, bukan 127.0.0.1 atau IP jaringan,
# supaya cookie login & CORS cocok.
NEXT_PUBLIC_API_URL=http://localhost:4000/api
