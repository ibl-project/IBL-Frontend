# URL Web App hasil deployment Google Apps Script
# Salin URL Web App dari langkah deployment (Langkah 5 di panduan setup) dan tempel di bawah ini:
NEXT_PUBLIC_BACKEND_URL=https://script.google.com/macros/s/AKfycbxxxxxxxxxXYZ/exec

# URL API backend IBL 2K26 (repo IBL-Backend), diakhiri /api.
# Lokal  : http://localhost:4000/api   (buka frontend lewat http://localhost:3000,
#          bukan 127.0.0.1 atau IP jaringan, supaya cookie login & CORS cocok)
# Produksi (Vercel): https://api.ibl-its.id/api
NEXT_PUBLIC_API_URL=http://localhost:4000/api
