# URL Web App hasil deployment Google Apps Script
NEXT_PUBLIC_BACKEND_URL=https://script.google.com/macros/s/AKfycbx9TSpeSa7EdjJDRIg_JB1Set5OVnV-r6590XtmANQA5h0MGps_BvH2wtyHIYzebHPe/exec

# URL API backend IBL 2K26 (repo IBL-Backend), diakhiri /api. Hanya untuk
# npm run dev di laptop: di Vercel, env NEXT_PUBLIC_API_URL dari dashboard yang dipakai.
# Ganti baris aktif lalu restart `npm run dev` (nilai NEXT_PUBLIC_* dibaca saat start).
# Staging (default untuk uji lokal):
NEXT_PUBLIC_API_URL=https://api-staging.ibl-its.id/api
# Produksi, DATA ASLI turnamen. Uncomment baris ini dan comment baris staging:
# NEXT_PUBLIC_API_URL=https://api.ibl-its.id/api
# Backend lokal (menjalankan IBL-Backend sendiri):
# NEXT_PUBLIC_API_URL=http://localhost:4000/api
